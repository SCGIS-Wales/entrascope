// Failed sign ins for one application, or for every application when the
// application filter is left empty.
// Parameters: lookback_hours, app_filter, row_limit
let lookback = {lookback_hours}h;
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType != 0
| where "{app_filter}" == "" or AppId == "{app_filter}" or AppDisplayName has "{app_filter}"
| project
    TimeGenerated,
    UserPrincipalName,
    AppId,
    AppDisplayName,
    ResourceDisplayName,
    ClientAppUsed,
    IPAddress,
    ResultType,
    ResultDescription,
    ConditionalAccessStatus,
    CorrelationId
| order by TimeGenerated desc
| take {row_limit}
